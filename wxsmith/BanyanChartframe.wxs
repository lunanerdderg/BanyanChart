<?xml version="1.0" encoding="utf-8" ?>
<wxsmith>
	<object class="wxFrame" name="BanyanChartFrame">
		<title>BanyanChart</title>
		<pos>50,50</pos>
		<size>800,600</size>
		<bg>wxSYS_COLOUR_WINDOW</bg>
		<id_arg>0</id_arg>
		<handler function="doubleClick" entry="EVT_LEFT_DCLICK" />
		<object class="wxBoxSizer" variable="BoxSizer1" member="no">
			<object class="sizeritem">
				<object class="wxPanel" name="ID_CANVAS" variable="Canvas" member="yes">
					<handler function="paintEvent" entry="EVT_PAINT" />
					<handler function="mouseDown" entry="EVT_LEFT_DOWN" />
					<handler function="mouseReleased" entry="EVT_LEFT_UP" />
					<handler function="rightClick" entry="EVT_RIGHT_DOWN" />
					<handler function="mouseMoved" entry="EVT_MOTION" />
					<handler function="mouseLeftWindow" entry="EVT_LEAVE_WINDOW" />
					<handler function="mouseWheelMoved" entry="EVT_MOUSEWHEEL" />
				</object>
				<flag>wxALL|wxALIGN_CENTER_HORIZONTAL|wxALIGN_CENTER_VERTICAL</flag>
				<border>5</border>
				<option>1</option>
			</object>
		</object>
		<object class="wxMenuBar" variable="MenuBar1" member="no">
			<object class="wxMenu" variable="Menu1" member="no">
				<label>&amp;File</label>
				<object class="wxMenuItem" name="idMenuNew" variable="MenuItem3" member="yes">
					<label>New</label>
					<accel>Ctrl-N</accel>
					<help>Create a new file</help>
				</object>
				<object class="wxMenuItem" name="idMenuOpen" variable="MenuItem4" member="yes">
					<label>Open</label>
					<accel>Ctrl-O</accel>
					<help>Open a file</help>
				</object>
				<object class="wxMenuItem" name="idMenuSave" variable="MenuItem5" member="yes">
					<label>Save</label>
					<accel>Ctrl-S</accel>
					<help>Save your file</help>
				</object>
				<object class="wxMenuItem" name="idMenuSaveAs" variable="MenuItem6" member="yes">
					<label>Save as</label>
					<accel>Ctrl-Shift-S</accel>
					<help>Save your file as</help>
				</object>
				<object class="wxMenuItem" name="idMenuQuit" variable="MenuItem1" member="no">
					<label>Quit</label>
					<accel>Ctrl-Q</accel>
					<help>Quit the application</help>
					<handler function="OnQuit" entry="EVT_MENU" />
				</object>
			</object>
			<object class="wxMenu" variable="Menu3" member="yes">
				<label>Edit</label>
				<object class="wxMenuItem" name="idMenuEditText" variable="MenuItem12" member="yes">
					<label>Edit text</label>
					<help>Edit the text of a block or node</help>
				</object>
				<object class="wxMenuItem" name="idMenuAddBlock" variable="MenuItem7" member="yes">
					<label>Add block</label>
					<help>Add a block</help>
				</object>
				<object class="wxMenuItem" name="idMenuAddNode" variable="MenuItem11" member="yes">
					<label>Add node</label>
					<help>Add a node to a block</help>
				</object>
				<object class="wxMenuItem" name="idMenuDelete" variable="MenuItem8" member="yes">
					<label>Delete</label>
					<accel>Delete</accel>
					<help>Delete a block</help>
				</object>
			</object>
			<object class="wxMenu" variable="Menu5" member="yes">
				<label>View</label>
				<object class="wxMenuItem" name="idMenuZoomIn" variable="MenuItem9" member="yes">
					<label>Zoom in</label>
					<accel>Ctrl-=</accel>
					<help>Zoom into the canvas</help>
				</object>
				<object class="wxMenuItem" name="idMenuZoomOut" variable="MenuItem10" member="yes">
					<label>Zoom out</label>
					<accel>Ctrl--</accel>
					<help>Zoom out of the canvas</help>
				</object>
			</object>
			<object class="wxMenu" variable="Menu2" member="no">
				<label>Help</label>
				<object class="wxMenuItem" name="idMenuAbout" variable="MenuItem2" member="no">
					<label>About</label>
					<accel>F1</accel>
					<help>Show info about this application</help>
					<handler function="OnAbout" entry="EVT_MENU" />
				</object>
			</object>
		</object>
		<object class="wxStatusBar" name="ID_STATUSBAR1" variable="StatusBar1" member="yes">
			<fields>1</fields>
			<widths>-1</widths>
			<styles>wxSB_NORMAL</styles>
		</object>
	</object>
</wxsmith>
